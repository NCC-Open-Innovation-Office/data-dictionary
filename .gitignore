.vscode/settings.json
.DS_Store

# Python build artifacts
__pycache__/
*.py[cod]
*.pyc
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Local development logs
*.log

# Type checker cache
.mypy_cache/

# Local SQLite database (runtime data, not source).
# The canonical database at data/dictionary.db is tracked intentionally;
# this rule only applies to stray copies at the repository root.
/dictionary.db

# Playwright MCP browser artifacts
.playwright-mcp/

# Local deployment overrides and secrets.
# These hold values that are specific to one deployment and must not
# be published. docker-compose.prod.yml stays tracked and generic;
# docker-compose.prod.local.yml carries the per-deployment values.
docker-compose.*.local.yml
.env
.env.*
